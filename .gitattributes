# Enforce LF line endings to avoid Prettier CRLF issues in CI
* text=auto eol=lf

# Ensure common text file types are normalized to LF
*.js     text eol=lf
*.jsx    text eol=lf
*.ts     text eol=lf
*.tsx    text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.html   text eol=lf
*.css    text eol=lf
*.scss   text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.graphql text eol=lf

# Binary files - keep as-is
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.pdf    binary
*.zip    binary
