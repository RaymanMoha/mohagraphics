# Environment Variables for AI Chat
# Copy this file to .env.local and add your actual API keys

# === FREE OPTIONS ===
# Option 1: Hugging Face (FREE - recommended)
# Get free key from: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=hf_your_free_api_key_here

# Option 2: Cohere (FREE tier available)
# Get free key from: https://dashboard.cohere.ai/api-keys
COHERE_API_KEY=your_cohere_api_key_here

# === PAID OPTIONS (more advanced) ===
# Option 3: OpenAI (paid but very intelligent)
# Get key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your_openai_key_here

# Option 4: Anthropic Claude (paid)
# Get key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here

# === AI MODEL PREFERENCES ===
# Choose which AI service to use (if multiple keys are provided)
# Options: "huggingface", "openai", "cohere", "anthropic"
PREFERRED_AI_SERVICE=huggingface
